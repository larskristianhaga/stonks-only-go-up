{
  "manifest_version": 3,
  "name": "Stonks Only Go Up",
  "version": "1.1",
  "description": "Removes the sell button from Nordnet, since Stonks can only go up! 💎👐",
   "icons": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://nordnet.no/*",
        "https://*.nordnet.no/*",
        "https://nordnet.se/*",
        "https://*.nordnet.se/*",
        "https://nordnet.fi/*",
        "https://*.nordnet.fi/*",
        "https://nordnet.dk/*",
        "https://*.nordnet.dk/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
